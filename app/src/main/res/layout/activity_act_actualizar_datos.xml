<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    tools:context=".Activitys.ActActualizarDatos">

    <View
        android:id="@+id/AdGlowTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.45"
        android:background="@drawable/bg_glow_purple"
        android:translationX="-60dp"
        android:translationY="-40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/AdGlowCenter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.22"
        android:background="@drawable/bg_glow_soft_white"
        android:translationY="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/AdGlowBottom"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.42"
        android:background="@drawable/bg_glow_pink"
        android:translationX="80dp"
        android:translationY="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/AdContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/layout_menu_superior" />

        <View
            android:id="@+id/IsTopDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/black" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="30dp"
            android:paddingTop="30dp"
            android:paddingEnd="30dp"
            android:paddingBottom="30dp">

        <ScrollView
            android:id="@+id/scrollActualizarDatos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/IsLayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_form_glass_panel"
                android:orientation="vertical"
                android:padding="15dp">


                <ImageButton
                    android:id="@+id/IsbtnRegresar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/regresarimg"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/IsTxtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Actualizar Datos"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/IsCardDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:background="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/IsTxtDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Ingresa la siguiente información:"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/IsTxtindicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text=" Campos marcados con * son obligatorios"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_artistlan"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:paddingStart="25dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:id="@+id/tvUsuario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Usuario"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/usuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_artistlan"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/tvFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Foto de perfil"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imgFotoPerfil"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/fotoperfilprueba"
                    android:background="@drawable/bg_form_glass_panel"
                    android:layout_gravity="center"/>

                <LinearLayout
                    android:id="@+id/contenedorCambiarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/btnCambiarFoto"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:adjustViewBounds="true"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_photo_camera_artistlan" />

                    <TextView
                        android:id="@+id/tvCambiarFotografia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Cambiar fotografía"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Nombre *"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_artistlan"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Juanito Perez"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:inputType="textPersonName" />

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Descripcion"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_artistlan"
                    android:gravity="top|start"
                    android:hint="Descripción Personal"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="10dp"
                    android:textColor="#202020" />

                <TextView
                    android:id="@+id/lsTxtCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="Ocupación"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinnerCategoriaUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_artistlan"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/tvRedes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Redes Sociales"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/redes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_artistlan"
                    android:gravity="top|start"
                    android:hint="https://www.youtube.com/usuario"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:padding="10dp"
                    android:textColor="#202020" />

                <TextView
                    android:id="@+id/tvTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teléfono"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/telefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_artistlan"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:hint="55XXXXXXXXX"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:inputType="phone"
                    android:maxLength="10" />

                <TextView
                    android:id="@+id/tvUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Ubicación"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ubicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input_artistlan"
                    android:hint="Opcional"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:inputType="textCapSentences" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fecha de Nacimiento *"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/CrcEdtFecha"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_input_artistlan"
                    android:hint="DÍA / MES / AÑO"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="#202020"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none"
                    android:textCursorDrawable="@null" />

                <Button
                    android:id="@+id/btnActualizarDatos"
                    android:layout_width="150dp"
                    android:layout_height="50dp"
                    android:text="Actualizar"
                    android:padding="10dp"
                    android:layout_marginBottom="24dp"
                    android:layout_gravity="center_horizontal" />

                <Button
                    android:id="@+id/btnEliminarCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Desactivar cuenta"
                    android:layout_marginBottom="16dp"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>
        </ScrollView>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
