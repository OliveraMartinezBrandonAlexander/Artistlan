<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/otpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_create_account_screen"
    android:padding="24dp"
    tools:context=".Activitys.ActVerificarOtpLogin">

    <LinearLayout
        android:id="@+id/otpCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_form_glass_panel"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/otpBackButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_back_bubble"
                android:contentDescription="Regresar"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/regresarimg" />

            <TextView
                android:id="@+id/otpTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Verificación en dos pasos"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="23sp" />

            <View
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:visibility="invisible" />
        </LinearLayout>

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/otpLottie"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/lottie_time" />

        <TextView
            android:id="@+id/otpInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Ingresa el código que enviamos a tu correo"
            android:textColor="@color/artistlan_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/otpCodeInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_artistlan"
            android:digits="0123456789"
            android:gravity="center"
            android:hint="123456"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/artistlan_text_primary"
            android:textColorHint="@color/artistlan_text_hint"
            android:textSize="20sp" />

        <Button
            android:id="@+id/otpVerifyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_bubble_glass_primary"
            android:text="Verificar"
            android:textAllCaps="false"
            android:textColor="@color/artistlan_text_primary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/otpResendButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_bubble_glass_secondary"
            android:text="Reenviar código"
            android:textAllCaps="false"
            android:textColor="@color/artistlan_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/otpResendCooldownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Puedes reenviar el código en 60 s"
            android:textColor="@color/artistlan_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/otpTimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Tiempo restante: 05:00"
            android:textColor="@color/artistlan_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>