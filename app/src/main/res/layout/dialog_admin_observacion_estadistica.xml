<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutObservacionDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tvObservacionDialogBadge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Obs"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvObservacionDialogTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Observaci&#243;n administrativa"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvObservacionDialogSubtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Agrega una nota breve para el contexto actual del dashboard."
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvObservacionDialogContextoLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Contexto"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/containerObservacionDialogContexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvObservacionDialogContexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="Contexto actual"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilObservacionDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Observaci&#243;n administrativa"
        app:boxBackgroundMode="filled"
        app:counterEnabled="true"
        app:counterMaxLength="400">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etObservacionDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="7"
            android:minLines="5"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvObservacionDialogAyuda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="La observaci&#243;n se mostrar&#225; solo a administradores dentro de este contexto."
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/progressObservacionDialog"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnObservacionDialogCancelar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnObservacionDialogGuardar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
