<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artistlanDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/artistlanDialogBadge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/artistlanDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/artistlanDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/artistlanDialogActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/artistlanDialogPositive"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/artistlanDialogNegative"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <Button
            android:id="@+id/artistlanDialogNeutral"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
