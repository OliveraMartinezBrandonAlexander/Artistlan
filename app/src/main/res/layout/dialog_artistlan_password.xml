<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/artistlanPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/artistlanPasswordBadge"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/artistlanPasswordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/artistlanPasswordMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/artistlanPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:padding="12dp"
        android:singleLine="true" />

    <ProgressBar
        android:id="@+id/artistlanPasswordProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/artistlanPasswordPositive"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-black"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <Button
        android:id="@+id/artistlanPasswordNegative"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        android:textSize="15sp" />

</LinearLayout>
