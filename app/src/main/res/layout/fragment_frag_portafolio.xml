<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".Fragments.FragPortafolio">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPortafolio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="true" />

    <LinearLayout
        android:id="@+id/portafolioHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="16dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/segmentContainerPortafolio"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_segment_container"
            android:padding="4dp">

            <View
                android:id="@+id/segmentIndicatorPortafolio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_segment_indicator" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSegmentMisObras"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="Mis Obras"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSegmentMisServicios"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="Mis Servicios"
                    android:textAllCaps="false"
                    android:textStyle="bold" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <com.getbase.floatingactionbutton.FloatingActionsMenu
        android:id="@+id/fabMenuSubir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="108dp"
        android:elevation="18dp"
        app:fab_addButtonColorNormal="@color/GRIS"
        app:fab_addButtonColorPressed="@color/GRIS"
        app:fab_labelStyle="@style/CustomFabLabelStyle">

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSubirObraMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_colorNormal="@android:color/white"
            app:fab_colorPressed="#00BCD4"
            app:fab_icon="@drawable/serport"
            app:fab_size="mini"
            app:fab_title="Subir Obra" />

        <com.getbase.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSubirServicioMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fab_colorNormal="@android:color/white"
            app:fab_colorPressed="#00BCD4"
            app:fab_icon="@drawable/serport"
            app:fab_size="mini"
            app:fab_title="Subir Servicio" />

    </com.getbase.floatingactionbutton.FloatingActionsMenu>

</FrameLayout>
