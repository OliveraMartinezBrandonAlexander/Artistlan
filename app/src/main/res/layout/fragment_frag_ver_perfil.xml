<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    tools:context=".Fragments.FragVerPerfil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artistlan_menu_stroke_soft" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="96dp"
        android:paddingBottom="108dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/contenedorPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPerfilInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/contenidoPerfilCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="20dp">

                        <ImageButton
                            android:id="@+id/btnEditarPefil"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Editar perfil"
                            android:padding="9dp"
                            android:src="@drawable/ic_edit"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <FrameLayout
                            android:id="@+id/frameFotoPerfil"
                            android:layout_width="136dp"
                            android:layout_height="136dp"
                            android:layout_marginTop="4dp"
                            android:padding="5dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <ImageView
                                android:id="@+id/imgPerfil"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/img_redonda"
                                android:clipToOutline="true"
                                android:scaleType="centerCrop"
                                android:src="@drawable/fotoperfilprueba" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/VrpTxvNombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="23sp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:hint="Usuario"
                            app:layout_constraintTop_toBottomOf="@id/frameFotoPerfil"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/VrpTxvDescripcion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="11dp"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="4"
                            android:ellipsize="end"
                            android:hint="Descripción"
                            app:layout_constraintTop_toBottomOf="@id/VrpTxvNombre"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <LinearLayout
                            android:id="@+id/expanded_section_perfil"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/VrpTxvDescripcion"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <LinearLayout
                                android:id="@+id/panelInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingTop="2dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Información personal"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Nombre completo"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvUsuario"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Nombre completo" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Correo"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvCorreo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Correo" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Teléfono"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvTelefono"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Teléfono" />
                                </LinearLayout>

                                <View
                                    android:id="@+id/dividerPerfilInfoPersonal"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="14dp"/>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Detalles"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Fecha de nacimiento"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvFecNac"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Fecha de nacimiento" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Ocupación"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvCategoria"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Ocupación" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="132dp"
                                        android:layout_height="wrap_content"
                                        android:text="Ubicación"
                                        android:textSize="12sp"/>

                                    <TextView
                                        android:id="@+id/VrpTxvUbicacion"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:textSize="14sp"
                                        android:hint="Ubicación" />
                                </LinearLayout>

                                <View
                                    android:id="@+id/dividerPerfilDetalles"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="14dp"/>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Redes"
                                    android:textStyle="bold"
                                    android:textSize="13sp"/>

                                <TextView
                                    android:id="@+id/VrpTxvRedes"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:paddingStart="12dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="12dp"
                                    android:paddingBottom="8dp"
                                    android:textSize="14sp"
                                    android:hint="Redes sociales" />

                                <LinearLayout
                                    android:id="@+id/contenedorRedesChips"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="vertical"
                                    android:visibility="gone" />

                            </LinearLayout>
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvTituloFavoritosPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:text="Mis favoritos"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

                <FrameLayout
                    android:id="@+id/contenedorTabsFavoritosPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_centro_tabs_container"
                    android:padding="4dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabFavoritosPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@android:color/transparent"
                        app:tabIndicatorHeight="0dp"
                        app:tabMode="fixed"
                        app:tabRippleColor="@android:color/transparent" />
                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFavoritosPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginTop="8dp"
                    android:minHeight="420dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>

                <TextView
                    android:id="@+id/tvFavoritosVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="No hay favoritos"
                    android:visibility="gone"/>


            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPerfilCompactoFlotante"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="16dp"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true"
        android:translationY="-8dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/headerPerfilCompacto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/frameFotoPerfilCompacta"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgPerfilCompacta"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/img_redonda"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/fotoperfilprueba" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvNombrePerfilCompacto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="2"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnEditarPerfilCompacto"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Editar perfil"
                android:padding="9dp"
                android:src="@drawable/ic_edit" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
