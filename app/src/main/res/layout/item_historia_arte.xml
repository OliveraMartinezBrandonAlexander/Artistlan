<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutHistoriaCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIconoHistoriaArte"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_button_soft"
            android:padding="9dp"
            android:src="@drawable/ic_history_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCategoriaHistoriaArte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_historia_chip"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Categoría"
                android:textAllCaps="true"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTituloHistoriaArte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Título"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvPeriodoHistoriaArte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_historia_chip"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="Periodo"
        android:textColor="@color/artistlan_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResumenHistoriaArte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Resumen breve"
        android:textColor="@color/artistlan_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDatoHistoriaArte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="Dato importante"
        android:textColor="@color/artistlan_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvContenidoHistoriaArte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="Contenido extendido"
        android:textColor="@color/artistlan_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvVerMasHistoriaArte"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_bubble_glass_secondary"
        android:gravity="center"
        android:text="Ver más"
        android:textColor="@color/artistlan_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
