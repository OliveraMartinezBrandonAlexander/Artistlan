<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutMainConvocatoriaCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/layoutMainConvocatoriaHeaderChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvMainTituloConvocatoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:letterSpacing="0"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMainFechaConvocatoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_historia_chip"
                android:letterSpacing="0.03"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="Fecha"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider sutil -->
        <View
            android:id="@+id/dividerMainConvocatoriaHeader"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="18dp" />

        <!-- Body -->
        <LinearLayout
            android:id="@+id/layoutMainConvocatoriaBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="18dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvMainDescripcionLabelConvocatoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textAllCaps="true"
                android:textColor="@color/artistlan_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvMainDescripcionConvocatoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMainDetalleConvocatoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMainVerDescripcionConvocatoria"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Ver detalles"
                android:textColor="@color/artistlan_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Divider antes del enlace -->
        <View
            android:id="@+id/dividerMainConvocatoriaEnlace"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="18dp" />

        <!-- Sección enlace -->
        <LinearLayout
            android:id="@+id/layoutMainConvocatoriaEnlaceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvMainEnlaceLabelConvocatoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enlace"
                android:textAllCaps="true"
                android:textColor="@color/artistlan_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Button
                android:id="@+id/btnMainVerMasConvocatoria"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:minWidth="144dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Saber más"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
